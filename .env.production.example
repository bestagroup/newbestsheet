APP_NAME="BestSheet VC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=30
LOG_DEPRECATIONS_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bestsheet
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
INVESTMENT_DOCUMENT_DISK=investment_documents
INVESTMENT_DOCUMENT_MAX_SIZE_KB=51200
# پس از اتصال موتور ضدبدافزار و worker اسکن روی true قرار گیرد.
INVESTMENT_DOCUMENT_ANTIVIRUS=false
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
FAILED_JOBS_RETENTION_HOURS=720

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://example.com/login/google/callback

GHASEDAK_API_KEY=
GHASEDAK_OTP_TEMPLATE=otploginbestsheet

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Operational SLA / SMS reminders
GHASEDAK_LINE_NUMBER=
OPERATIONAL_SMS_ENABLED=true
OPERATIONAL_DELIVERY_MAX_ATTEMPTS=3
OPERATIONAL_DELIVERY_CLAIM_TIMEOUT_MINUTES=15
OPERATIONAL_REMINDERS_ENABLED=true
KPI_REMINDER_DAYS=7,3,1,0
KPI_OVERDUE_REMINDER_DAYS=1,3,7
COMMITMENT_REMINDER_DAYS=14,7,3,1,0
COMMITMENT_OVERDUE_REMINDER_DAYS=1,3,7
CALENDAR_REMINDER_MINUTES=1440,60
